# TLS-shipinhao / TLS-Keeper 本地环境变量模板
# 说明：先在这里填写真实值；其中 Cloudflare Worker 线上仍需使用 `wrangler secret put` 注入 Secret。
# 本文件用于统一收集需要的环境变量，避免联调时遗漏。

# =========================
# Worker / 授权服务 Secrets
# =========================
# 旧版兼容签名密钥（如不需要兼容旧 HMAC，可先留空）
HMAC_SECRET=

# 管理端鉴权密钥（/api/admin/* 与 /api/lease/revoke 需要）
ADMIN_SECRET=

# Ed25519 私钥（Base64），用于签发 license lease / new_token
LICENSE_SIGNING_PRIVATE_KEY_B64=

# =========================
# 完整性清单签名（xtask / 构建时）
# =========================
# 用于生成 integrity_manifest.json 的 Ed25519 私钥（Base64）
INTEGRITY_MANIFEST_PRIVATE_KEY_B64=

# 完整性签名 key id（可选，未填写时代码会回退默认值）
INTEGRITY_MANIFEST_KEY_ID=

# =========================
# Cloudflare / D1 说明项
# =========================
# 注意：下面这些不是代码直接读取的标准 dotenv 变量，主要作为联调登记位。
# 实际 Cloudflare Worker 运行时请通过 backend/wrangler.toml + wrangler secret / D1 binding 配置。

# D1 数据库绑定名（wrangler.toml 中固定为 DB）
D1_BINDING=

# D1 数据库名称（参考 backend/wrangler.toml）
D1_DATABASE_NAME=

# D1 数据库 ID（测试/预发时替换成你的真实值）
D1_DATABASE_ID=

# Cloudflare 账户 ID（如本地 wrangler / CI 需要）
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token（如本地 wrangler / CI 需要）
CLOUDFLARE_API_TOKEN=

# =========================
# 本地桌面 / 前端开发可选项
# =========================
# Vite / Tauri dev host（仅在特殊网络环境下需要）
TAURI_DEV_HOST=

# 本机名（一般无需手填；仅在特定测试场景下覆盖系统自动探测时使用）
HOSTNAME=
COMPUTERNAME=

# =========================
# 联调记录占位（非程序直接读取）
# =========================
# 可用测试卡密
TEST_LICENSE_KEY=

# Worker 本地 / 测试环境基础地址（例如 http://127.0.0.1:8787）
LICENSE_WORKER_BASE_URL=

# 备注：客户端内置公钥当前写死在 Rust/Python 代码中，不需要在 .env 中填写：
# LICENSE_PUBLIC_KEY_B64 = H0KTidHIXV0nvzkUNmssrx5t5IrUvEQi1WVelkuCJm8


{
  "private": true,
  "scripts": {
    "dev": "pnpm --filter tls-shipinhao-ui dev",
    "build": "pnpm --filter tls-shipinhao-ui build",
    "lint": "pnpm run lint:ui",
    "lint:ui": "pnpm --filter tls-shipinhao-ui lint",
    "lint:rust": "cargo clippy --workspace --quiet -- -D warnings",
    "lint:fmt": "cargo fmt --all --check",
    "lint:all": "pnpm run lint:ui && pnpm run lint:fmt && pnpm run lint:rust",
    "test": "pnpm run test:ui && pnpm run test:rust",
    "test:ui": "pnpm --filter tls-shipinhao-ui test",
    "test:ui:watch": "pnpm --filter tls-shipinhao-ui test:watch",
    "test:ui:coverage": "pnpm --filter tls-shipinhao-ui test:coverage",
    "test:rust": "cargo test --workspace --quiet",
    "verify": "./scripts/verify.sh",
    "tauri:dev": "./scripts/tauri_dev.sh",
    "tauri:build": "cd apps/desktop && cargo tauri build",
    "release:build": "node scripts/build-release.mjs",
    "release:build:plain": "node scripts/build-release.mjs --no-obfuscate",
    "release:build:deep": "node scripts/build-obfuscate.mjs",
    "release:build:deep:mirror-only": "node scripts/build-obfuscate.mjs --skip-build",
    "worker:deploy": "cd backend && npx wrangler deploy",
    "worker:deploy:preview": "cd backend && npx wrangler versions upload",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}

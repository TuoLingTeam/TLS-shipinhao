{
  "productName": "驼铃·视频小店差评处理",
  "version": "5.1.0",
  "identifier": "com.tls.shipinhao",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter tls-shipinhao-ui dev",
    "beforeBuildCommand": "pnpm --filter tls-shipinhao-ui build"
  },
  "app": {
    "windows": [
      {
        "title": "驼铃·视频小店差评处理 5.1.0",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

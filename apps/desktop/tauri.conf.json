{
  "productName": "驼铃·视频小店差评处理",
  "version": "5.0.3",
  "identifier": "com.tls.shipinhao",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter tls-shipinhao-ui dev",
    "beforeBuildCommand": "pnpm --filter tls-shipinhao-ui build"
  },
  "app": {
    "windows": [
      {
        "title": "驼铃·视频小店差评处理",
        "width": 1160,
        "height": 760,
        "minWidth": 768,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: https://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "TLS-801",
    "copyright": "Copyright © TLS-801",
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"]
      }
    }
  }
}
